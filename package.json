{
  "name": "fantasytool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "dev:mock": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts --mock\" \"vite\"",
    "build": "vite build && npm run build:server",
    "start": "node dist-server/index.js",
    "serve": "npm run build && npm start",
    "check:sleeper": "tsx scripts/check-sleeper.ts",
    "check:stats": "tsx scripts/check-stats.ts",
    "check:logos": "tsx scripts/check-logos.ts",
    "db:import": "tsx scripts/import-cache.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist-server/index.js --log-level=warning"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
