# Copy this file to .env and fill in what you need. Everything is optional.

# Skip the league picker and always open this league.
# Find it in the Sleeper web app URL: sleeper.com/leagues/<LEAGUE_ID>/...
SLEEPER_LEAGUE_ID=

# How long league data is reused before Sleeper is asked again (minutes).
LEAGUE_CACHE_MINUTES=60

# Shortest gap between two forced refreshes of the same league (seconds).
MIN_REFRESH_SECONDS=60

# Port for the local backend.
PORT=8787

# balldontlie API key for NBA player stats (ALL-STAR plan or higher).
# Keep the real key in .env only. .env is ignored by git.
# Without a key the app still works, but shows no player stats.
BALLDONTLIE_API_KEY=

# How long player stats are reused before new games are downloaded (hours).
STATS_CACHE_HOURS=6

# Optional: keep saved data in Postgres instead of files in .cache/.
# Heroku sets this for you. Locally, after `brew install postgresql@17`:
# DATABASE_URL=postgres://localhost/fantasytool
